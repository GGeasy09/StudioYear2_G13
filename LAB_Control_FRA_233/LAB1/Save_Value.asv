clear;

% --- Parameters to vary (Rows of our table) ---
% Each row is [B, eff, Ke, J]
params = [
        2.32E-04,0.9993593243,0.03630453469,8.77E-05; % Params Set 1
        5.13E-05,0.9978452448,0.05486926168,1.66E-05; % Params Set 2
        1.73E-04,0.9991082731,0.04083881541,4.16E-05 % Params Set 3
];

Validation_Para = {
   'Lab1 Part2 Data\Lab1 Part2 Data\lap1_sine_v12_2000hz_pi11_3.mat','Lab1 Part2 Parameter\sine_freqpi';
   'Lab1 Part2 Data\Lab1 Part2 Data\lap1_sine_v12_2000hz_pi12_1.mat','Lab1 Part2 Parameter\Stair_wait0.1.mat';
   'Lab1 Part2 Data\Lab1 Part2 Data\lap1_sine_v12_2000hz_pi14_3_3.mat','Lab1 Part2 Parameter\Stair_wait0.5.mat'    
};

modelName = 'Lab1_parameter_estimation_student';
R_val = 3.341;
L_val = 0.02587;

% Pre-allocate the 3x3 RMSE table
rmse_table = zeros(3, 3);

for i = 1:3 % Loop through Parameter Sets (Rows)
    for j = 1:3 % Loop through Validation Data (Columns)
        
        fprintf('Testing Params %d against Validation %d...\n', i, j);
        
        simIn = Simulink.SimulationInput(modelName);
        
        % 1. Load the input setup for this validation case (Step_12V.mat)
        matVars = load(Validation_Para{j, 2});
        vNames = fieldnames(matVars);
        for k = 1:numel(vNames)
            simIn = simIn.setVariable(vNames{k}, matVars.(vNames{k}));
        end
        
        % 2. Inject the specific parameters from our 'params' list
        simIn = simIn.setVariable('motor_R',   R_val);
        simIn = simIn.setVariable('motor_L',   L_val);
        simIn = simIn.setVariable('motor_B',   params(i, 1));
        simIn = simIn.setVariable('motor_Eff', params(i, 2));
        simIn = simIn.setVariable('motor_J',   params(i, 4));
        simIn = simIn.setVariable('motor_Ke',  params(i, 3));
        
        % 3. Run Simulation
        out = sim(simIn);
        pred_signal = out.Estimate_Result.signals.values;
      
        % 4. Load Validation Signal
        valData = load(Validation_Para{j, 1});
        if isfield(valData, 'raw_data_shift')
            val_signal = valData.raw_data_shift;
        elseif isfield(valData, 'speed')
            val_signal = valData.speed;
        else
            error('Validation file "%s" does not contain ''raw_data_shift'' or ''speed''.', Validation_Para{j,1});
        end
   
        
        % 5. Calculate RMSE and store in the matrix
        n = min(numel(pred_signal), numel(val_signal));
        diff = pred_signal(1:n) - val_signal(1:n);
        rmse_table(i, j) = sqrt(mean(diff.^2));
        
    end
end

% --- 1. Calculate Row-wise Averages ---
% mean(..., 2) calculates the mean along the second dimension (columns)
row_averages = mean(rmse_table, 2);

% --- 2. Combine with Original Matrix ---
table_data = [rmse_table, row_averages];

% --- 3. Create Formatted Table ---
Final_Results = array2table(table_data, ...
    'VariableNames', {'Val_Data_1', 'Val_Data_2', 'Val_Data_3', 'Average_RMSE'}, ...
    'RowNames', {'Params_Set_1', 'Params_Set_2', 'Params_Set_3'});

% --- เปลี่ยนจากตัวเลขเป็น String ที่ระบุทศนิยม 4 ตำแหน่ง ---
table_strings = arrayfun(@(x) sprintf('%.5f', x), table_data, 'UniformOutput', false);

% --- สร้าง Table ใหม่จาก String ---
Final_Results = cell2table(table_strings, ...
    'VariableNames', {'Val_Data_1', 'Val_Data_2', 'Val_Data_3', 'Average_RMSE'}, ...
    'RowNames', {'Params_Set_1', 'Params_Set_2', 'Params_Set_3'});

% --- 4. Display ---
fprintf('\n--- Cross-Validation RMSE Table with Averages ---\n');
disp(Final_Results);

% --- 5. Identify the "Winner" ---
[min_avg, best_idx] = min(row_averages);
fprintf('The most robust parameter set is Set %d with an average RMSE of %.5f\n', best_idx, min_avg);

% --- Display the Result as a Formatted Table ---
Final_Results = array2table(rmse_table, ...
    'VariableNames', {'Val_Data_1', 'Val_Data_2', 'Val_Data_3'}, ...
    'RowNames', {'Params_Set_1', 'Params_Set_2', 'Params_Set_3'});
