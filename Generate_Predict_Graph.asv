%% Fucking Universal Parameter
function loading = fuking_universe(filename,B,eff,J,ke,parameter)
folderPath = 'C:\Users\ACER\Documents\GitHub\StudioYear2_G13\Lab1 Part2 Data\Lab1 Part2 Data Predicted Val';
load(parameter)
fullFile = fullfile(folderPath, filename);
motor_R = 3.341;
motor_L = 0.02587;
motor_B = B;
motor_Eff = eff;
motor_Ke = ke;
motor_J = J;

out = sim('parameter_motor', ...
    'ReturnWorkspaceOutputs','on');
Signal = out.y.Estimate_Result;
time = out.y.time;
save(fullFile,"Signal","time")
clear;
end